# Local user data and session history (excluded from Git)
data/
projects/*
!projects/.gitkeep
*.db
*.sqlite
*.sqlite3
local_config.json
.env
*.lnk

# Python cache and virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
build/
dist/
*.spec

# IDE / OS settings
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test / temp artifacts
.pytest_cache/
*.tmp

# Working files from AI assistants (screenshots and archives contain local project data)
Claude outputs/
.claude/
